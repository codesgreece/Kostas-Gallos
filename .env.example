# Public site URL (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://kostaskipoi.vercel.app

# Admin panel password (required for /admin)
ADMIN_PASSWORD=change-me

# Optional: dedicated signing secret for admin session cookies
ADMIN_SESSION_SECRET=change-me-too

# Optional but required on Vercel for upload/delete persistence
# Create a Blob store in the Vercel dashboard and paste the token here
BLOB_READ_WRITE_TOKEN=
